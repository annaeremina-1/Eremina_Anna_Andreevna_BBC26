import random

while True:
    # --- ИНИЦИАЛИЗАЦИЯ ИГРЫ ---
    n = 5  # Размер сетки N x N
    room_types = ["Пустая", "Сундук", "Монстр", "Ловушка", "Ключ", "Портал", "Выход"]

    # 6** Генератор коллекции для создания карты
    grid = [[random.choice(room_types) for _ in range(n)] for _ in range(n)]

    # Выход в случайной точке
    exit_x = random.randint(0, n - 1)
    exit_y = random.randint(0, n - 1)
    if exit_x == 0 and exit_y == 0:
        exit_x, exit_y = 4, 4
    grid[exit_y][exit_x] = "Выход"

    # Туман войны (False - скрыто '*', True - открыто)
    fog = [[False for _ in range(n)] for _ in range(n)]

    # Игрок
    hp = 100
    x, y = 0, 0
    fog[y][x] = True  # Стартовая клетка открыта

    # 1. Расширенный начальный инвентарь
    inventory = [
        "Деревянный щит", 
        "Зелье здоровья", 
        "Охотничий нож", 
        "Факел", 
        "Компас"
    ]

    print("\n" + "=" * 45)
    print("        НОВАЯ ИГРА: ЛАБИРИНТ СТАРТОВАЛ        ")
    print("=" * 45)

    game_over = False

    while hp > 0 and not game_over:
        # Отображение параметров игрока
        print(f"\n Ваша позиция: X = {x}, Y = {y} | Здоровье: {hp} HP")
        print("-" * 45)

        # Подпись осей X
        print("    ", end="")
        for col in range(n):
            print(f"X:{col} ", end="")
        print()

        # Отображение сетки
        for row in range(n):
            print(f"Y:{row} ", end="")
            for col in range(n):
                if col == x and row == y:
                    print("[P] ", end="")  # Игрок
                elif fog[row][col]:
                    print(f" {grid[row][col][0]}  ", end="")
                else:
                    print(" *  ", end="")
            print()
        print("-" * 45)

        # Меню управления
        print(" НАЖМИТЕ КЛАВИШУ ДЛЯ ДЕЙСТВИЯ:")
        print("  [w] Вверх | [s] Вниз | [a] Влево | [d] Вправо")
        print("  [q] Л-Вверх | [e] П-Вверх | [z] Л-Вниз | [c] П-Вниз")
        print("  [2] 🎒 Открыть Инвентарь | [r] 🔄 Перезапуск")

        cmd = input("\nВведи команду/клавишу направления: ").strip().lower()

        # Быстрый рестарт
        if cmd == "r":
            print("\n Перезапуск лабиринта...")
            break

        # Вход в инвентарь
        elif cmd == "2":
            print("\n" + "=" * 40)
            print("         ВАШ ТЕКУЩИЙ ИНВЕНТАРЬ          ")
            print("=" * 40)
            if len(inventory) == 0:
                print(" (Инвентарь пуст)")
            else:
                for idx, item in enumerate(inventory, 1):
                    print(f"  {idx}. {item}")
            print("=" * 40)

            print("\n ДЕЙСТВИЯ С ИНВЕНТАРЕМ:")
            print("1 - Выбросить конкретный предмет по названию (remove)")
            print("2 - Выбросить самый последний предмет (pop)")
            print("3 - Сортировка инвентаря (sort/reverse)")
            print("4 - Зачаровать все предметы (генератор списка)")
            print("5 - Скопировать инвентарь (срез slice [:])")

            inv_cmd = input("\nВыберите действие с инвентарем (1-5): ").strip()

            if inv_cmd == "1":
                item_to_remove = input("Введите точное название предмета: ").strip()
                if item_to_remove in inventory:
                    inventory.remove(item_to_remove)
                    print(f" Предмет '{item_to_remove}' выброшен.")
                else:
                    print(" Такого предмета у вас нет!")

            elif inv_cmd == "2":
                if len(inventory) > 0:
                    popped = inventory.pop()
                    print(f" Вы выбросили последний предмет: '{popped}'")
                else:
                    print(" Инвентарь пуст!")

            elif inv_cmd == "3":
                ans = input("Отсортировать в обратном порядке? (да/нет): ").strip().lower()
                inventory.sort(reverse=(ans == "да"))
                print(" Инвентарь отсортирован!")

            elif inv_cmd == "4":
                # Генератор списка с if/else
                inventory = [
                    f"Зачарованный {item}" if "Зачарованный" not in item else f"Супер {item}"
                    for item in inventory
                ]
                print(" Все предметы зачарованы!")

            elif inv_cmd == "5":
                # Срез [:]
                inv_copy = inventory[:]
                inv_copy.append("Секретный дубликат")
                print("\n Исходный инвентарь (без изменений):", inventory)
                print(" Скопированный через срез [:]:", inv_copy)

        # Логика движения (срабатывает сразу при вводе w/a/s/d/q/e/z/c)
        elif cmd in ['w', 's', 'a', 'd', 'q', 'e', 'z', 'c']:
            new_x, new_y = x, y

            if cmd == 'w': new_y -= 1
            elif cmd == 's': new_y += 1
            elif cmd == 'a': new_x -= 1
            elif cmd == 'd': new_x += 1
            elif cmd == 'q': new_x -= 1; new_y -= 1
            elif cmd == 'e': new_x += 1; new_y -= 1
            elif cmd == 'z': new_x -= 1; new_y += 1
            elif cmd == 'c': new_x += 1; new_y += 1

            # Проверка границ сетки (стен)
            if 0 <= new_x < n and 0 <= new_y < n:
                x, y = new_x, new_y
                fog[y][x] = True

                current_room = grid[y][x]
                print(f"\n Вы перешли в клетку ({x}, {y}). Событие: [{current_room}]")

                if current_room == "Пустая":
                    print("Вы зашли в пустую комнату. Тишина...")
                elif current_room == "Сундук":
                    loot = ["Золотая монета", "Древний свиток", "Железный меч", "Шлем"]
                    item = random.choice(loot)
                    print(f" Вы открыли сундук и забрали: '{item}'")
                    inventory.append(item)
                elif current_room == "Монстр":
                    dmg = random.randint(15, 25)
                    hp -= dmg
                    print(f" На вас напал Монстр! Вы потеряли {dmg} HP.")
                    trophies = ["Клык монстра", "Ухо гоблина"]
                    inventory.extend(trophies)
                    print(f" Забранные трофеи: {trophies}")
                elif current_room == "Ловушка":
                    dmg = random.randint(10, 20)
                    hp -= dmg
                    print(f" Вы попали в ловушку со стрелами! -{dmg} HP.")
                elif current_room == "Ключ":
                    print(" Вы нашли 'Золотой ключ'!")
                    inventory.append("Золотой ключ")
                elif current_room == "Портал":
                    print(" Мерцающий портал перенес вас в случайную точку!")
                    x = random.randint(0, n - 1)
                    y = random.randint(0, n - 1)
                    fog[y][x] = True
                elif current_room == "Выход":
                    if "Золотой ключ" in inventory:
                        idx = inventory.index("Золотой ключ")
                        print(f" Вы нашли Выход! 'Золотой ключ' найден в ячейке №{idx + 1}.")
                        print("Вы открыли замки и выбрались из лабиринта! ПОБЕДА!")
                        game_over = True
                    else:
                        print(" Вы у закрытой двери Выхода. Нужен 'Золотой ключ'!")

            else:
                print(" ОСТОРОЖНО, СТЕНА! Вы не можете уйти за пределы сетки.")

        else:
            print(" Неизвестная команда! Используйте w/a/s/d для движения или 2 для инвентаря.")

    if hp <= 0:
        print("\n Ваши HP закончились... Вы погибли в лабиринте.")

    print("\n" + "=" * 40)
    print(" [ ENTER / 1 ] - НАЧАТЬ ЗАНОГО ")
    print(" [     0     ] - ВЫЙТИ ИЗ ИГРЫ ")
    print("=" * 40)

    restart_btn = input("Выберите вариант: ").strip()
    if restart_btn == "0":
        print("Выход из игры. До встречи!")
        break
