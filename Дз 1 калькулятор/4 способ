def abc(a, b, n):
    if n == '+':
        print(a + b)
    elif n == '-':
        print(a - b)
    elif n == '*':
        print(a * b)
    elif n == '/':
        print(a / b)

while True:
    a = int(input("Число 1: "))
    b = int(input("Число 2: "))
    n = input("Операция (+, -, *, /): ")
    
    abc(a, b, n)
    
    repeat = input("Выполнить еще раз? (да/нет): ").lower()
    if repeat in ["нет", "n", "no"]:
        break
